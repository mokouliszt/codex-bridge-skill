{
  "_note": "任意。codex-bridge の token store 用 S3 互換ストレージ認証情報。auth/credentials.json にコピーして記入。",
  "provider": "backblaze-b2",
  "endpoint": "s3.us-east-005.backblazeb2.com",
  "region": "us-east-005",
  "bucket": "your-bucket",
  "key_id": "your-key-id",
  "application_key": "your-application-key",
  "object_key": "_codex-bridge/auth.json"
}
